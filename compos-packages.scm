;;; compos-packages.scm --- the standard packages of compos.
;;;
;;; One directory for each package. This file puts every one of them on
;;; load-path, so (require 'NAME) finds NAME/NAME.scm, then loads the stock
;;; set in the order the stock boot has always used. A package not in the
;;; stock set loads on first use: its ;;;###autoload cookies are harvested
;;; with the rest at the end of core's init.scm.
;;;
;;; Core loads this file from priv/init.scm with
;;;   (package-seed! 'compos-packages)
;;;   (use-package 'compos-packages)
;;; A release bundles the clone pinned in core's priv/standard.lock.

(define compos-packages-root (package-directory "compos-packages"))

(define (compos-packages-dirs)
  "every package directory of compos-packages"
  (map (lambda (e) (string-append compos-packages-root "/" (substring (plist-get e 'name) 0 (- (string-length (plist-get e 'name)) 1))))
       (filter (lambda (e) (and (equal? (plist-get e 'type) "directory")
                                (not (string-prefix? "." (plist-get e 'name)))))
               (ls compos-packages-root))))

(for-each (lambda (d) (unless (member d load-path) (set! load-path (append load-path (list d)))))
          (compos-packages-dirs))

;; the stock set, in load order: (FEATURE) or (FEATURE "dir/file.scm")
